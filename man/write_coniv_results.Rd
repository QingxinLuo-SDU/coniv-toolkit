\name{write_coniv_results}
\alias{write_coniv_results}
\title{Write CON-IV result files}
\usage{write_coniv_results(result, output_dir)}
\arguments{
  \item{result}{A result returned by \code{run_coniv()}.}
  \item{output_dir}{Output directory.}
}
\value{The normalized output directory, invisibly.}
\description{Writes the stable CON-IV output contract without including input-level rows.}

